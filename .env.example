# Copy to .env (gitignored).
DATABASE_URL=postgresql://arena:arena@localhost:5434/arena

# Set a HARD monthly spend limit in each provider console before using these.
ANTHROPIC_API_KEY=
# Only needed for OpenAI players (commented out in roster.example.toml).
# OPENAI_API_KEY=

ARENA_ROSTER_PATH=roster.toml
ARENA_LEASE_SECONDS=60
ARENA_HEARTBEAT_SECONDS=20
ARENA_MAX_RUN_ATTEMPTS=5

# Traces, with `docker compose --profile observability up -d`:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
